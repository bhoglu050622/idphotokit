{
  // Cloudflare Workers: the built site in dist/ as static assets, plus worker/index.ts for
  // /api/* only (the feedback form). Deploy with `npm run deploy` (builds first).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idphotokit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Served at https://rightidphoto.com (and www). The workers.dev address stays on so old
  // links keep working; every page's canonical URL points at the domain.
  "routes": [
    { "pattern": "rightidphoto.com", "custom_domain": true },
    { "pattern": "www.rightidphoto.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API runs the Worker; every page and file is served straight from assets.
    "run_worker_first": ["/api/*"],
    // /photo/india serves photo/india.html, as cleanUrls did on Vercel.
    "html_handling": "drop-trailing-slash",
    // Any other path loads the app, which reads the URL itself.
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // Where feedback is filed. GITHUB_TOKEN and TURNSTILE_SECRET are secrets, not vars.
    "GITHUB_REPO": "vijayanandraj/idphotokit"
  },
  // Five reports a minute per IP is generous for a person and dull for a script. A person
  // likes once (the page remembers); three a minute leaves room for a shared connection.
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LIKE_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  // The "it worked for me" count: one SQLite-backed Durable Object (worker/index.ts).
  "durable_objects": {
    "bindings": [{ "name": "LIKES", "class_name": "LikeCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LikeCounter"] }]
}
